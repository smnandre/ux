{# @var package \App\Model\UxPackage #}
<div class="PackageNav" style="--gradient: {{ package.gradient }};--color: {{ package.color }};">
    
    <div class="PackageNav_inner container-fluid container-xxl px-4 px-md-5 position-relative" >
        
        <div class="PackageNav_meta">
            <a href="{{ url(package.route) }}" class="PackageNav_media" title="{{ package.humanName }}" id="{{ package.name }}-icon">
                <twig:Package:PackageIcon package="{{ package }}" aria-described-by="{{ package.name }}-icon" />
            </a>
            <div class="PackageNav_info">
                <a href="{{ url(package.route) }}" class="PackageNav_title" title="{{ package.humanName }}">
                    {{- package.humanName -}}
                </a>
                <div class="PackageNav_metadata">
                    <code>symfony/<strong>{{- package.composerName|slice(8) }}</strong></code>
                </div>
            </div>
        </div>
        
        {% set menu_items = {
            'install': {
                label: 'Installation',
            },
            'documentation': {
                label: 'Documentation',
                icon: 'documentation',
            },
            'support': {
                label: 'Support',
                icon: 'support',
            },
            'contrib': {
                label: 'Github',
                icon: 'github',
            },
        } %}
        
        {#
            documentation: {
                icon: 'documentation',
                label: 'Documentation',
                title: 'Read LiveComponent Documentation',
                url: 'https://symfony.com/doc/current/ux.html',
            }
        #}
        <nav class="PackageNav_menu">
            {%- for key, item in menu_items -%}
                <a href="{{ item.url ?? '#%s'|format(key) }}" 
                   class="PackageNav_item" 
                   title="{{ item.title ?? [package.humanName, item.label]|join(' ') }}"
                >                    
                    {%- if item.icon|default %}
                        <twig:ux:icon name="{{ item.icon }}" class="PackageNav_item_icon" />
                    {%- endif -%}
                    <span>{{ item.label }}</span>
                </a>
            {%- endfor -%}
        </nav>

    </div>
</div>
