{# @var package \App\Model\UxPackage #}
<div class="PackageNav" style="--gradient: {{ package.gradient }};--color: {{ package.color }};">
    
    <div class="container-fluid container-xxl px-4 px-md-5 position-relative" >
        <style>
            .PackageIcon {
              --logo-size: 6rem;
              background: var(--gradient);
              background-color: var(--color);
              width: var(--logo-size);
              height: var(--logo-size);
              border-radius: 14%;
              display: flex;
              align-items: center;
              justify-content: center;
              flex-shrink: 0;
            }
        </style>
        
        <a href="{{ url(package.route) }}" class="PackageNav_title" title="{ package.humanName }}">
            
            <twig:Package:PackageIcon package="{{ package }}" class="PackageNav_icon" />
            
            <span>
                {{ package.humanName }}
            </span>
            
        </a>
        
        {% set package_links = {
            'features': {
                label: 'Features',
                url: '#',
                title: 'Features'
            },
            'install': {
                label: 'Installation',
            },
            'documentation': {
                label: 'Documentation',
            },
            'support': {
                label: 'Support',
            },
        } %}
        
        <nav class="PackageNav_menu">
            {% for id, link in package_links -%}
                <a href="{{ link.url ?? '#'~id }}" class="PackageNav_link {{ link.class|default  ? ' '~link.class }}" 
                   title="{{ link.title ?? [package.humanName,link.label]|join(' ') }}">
                    {{ link.label }}
                </a>
            {%- endfor %}
        </nav>

    </div>
</div>
